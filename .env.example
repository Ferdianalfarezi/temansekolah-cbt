# Application
NODE_ENV=development
PORT=5003

# Database (PostgreSQL — shared with LMS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teman_sekolah

# Redis (Bull queues, Socket.IO adapter, session cache)
REDIS_URL=redis://localhost:6379

# JWT (MUST match JWT_ACCESS_SECRET from LMS service)
JWT_ACCESS_SECRET=your-jwt-access-secret-must-match-lms
# Legacy fallback (JWT_SECRET still works but JWT_ACCESS_SECRET takes priority)
# JWT_SECRET=your-jwt-secret

# CORS (comma-separated origins for admin + siswa frontends)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# S3 (Question images storage)
S3_BUCKET=cbt-question-images
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
