# ═══════════════════════════════════════════════════════════════════
# CBT Siswa PWA — Production Environment
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env.production.local for actual values.
# These values are embedded at build time by Vite.

# API base URL (backend)
VITE_API_BASE_URL=https://cbt-api.teman-sekolah.com

# WebSocket URL (exam real-time)
VITE_WS_URL=wss://cbt-api.teman-sekolah.com

# App title
VITE_APP_TITLE=CBT Teman Sekolah

# PWA configuration
VITE_PWA_NAME=CBT Teman Sekolah
VITE_PWA_SHORT_NAME=CBT

# Sentry DSN (optional — error tracking)
VITE_SENTRY_DSN=

# Build metadata
VITE_BUILD_VERSION=
VITE_BUILD_TIMESTAMP=
