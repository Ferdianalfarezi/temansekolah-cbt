# ═══════════════════════════════════════════════════════════════════
# CBT Admin Panel — Production Environment
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env.production.local for actual values.
# These values are embedded at build time by Vite.

# API base URL (CBT backend)
VITE_API_URL=https://cbt-api.teman-sekolah.com/api/v1

# LMS API URL (for standalone login)
VITE_LMS_API_URL=https://api.teman-sekolah.com/api/v1

# WebSocket URL (proctor dashboard)
VITE_WS_URL=wss://cbt-api.teman-sekolah.com

# App title
VITE_APP_TITLE=CBT Teman Sekolah - Admin

# Sentry DSN (optional — error tracking)
VITE_SENTRY_DSN=

# Build metadata
VITE_BUILD_VERSION=
VITE_BUILD_TIMESTAMP=
